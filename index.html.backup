<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#20120c" />

  <meta name="description"
    content="Discover thoughtfully crafted instant coffee, roasted beans and brew bags from Brown Ocean Coffee." />

  <title>Brown Ocean Coffee — The Art of the Ocean Brew</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <link rel="icon" type="image/png" href="./assets/images/brown-ocean-emblem.png" />

  <link rel="stylesheet" href="styles.css" />
</head>

<body>

  <!-- Announcement Bar -->
  <div class="announcement">
    A little more ritual. A lot more aroma.
    <span>Explore the collection&nbsp; ↗</span>
  </div>

  <!-- Header / Navbar -->
  <header class="site-header" id="top">

    <!-- Brand Logo + Text -->
    <a class="brand" href="#top" aria-label="Brown Ocean Coffee home">

      <img
        class="brand-logo"
        src="./assets/images/brown-ocean-coffee-circular-badge.png"
        alt="Brown Ocean Coffee circular logo"
      >

      <span class="brand-text">
        <span class="brand-name">BROWN OCEAN</span>
        <span class="brand-tagline">C O F F E E</span>
      </span>

    </a>

    <!-- Mobile Menu -->
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">
      ☰
    </button>

    <!-- Navigation -->
    <nav class="main-nav" aria-label="Main navigation">
      <a href="#shop">Shop</a>
      <a href="#story">Our story</a>
      <a href="#ritual">The ritual</a>
      <a href="#footer">Contact</a>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">

      <button class="icon-btn search-open" aria-label="Search products">
        ⌕
      </button>

      <button class="icon-btn account-btn" aria-label="Account">
        ♙
      </button>

      <button class="cart-open" aria-label="Open cart">
        Bag <span id="cart-count">0</span>
      </button>

    </div>

  </header>

  <main>

    <!-- Hero Section -->
    <section class="hero">

      <div class="hero-copy reveal">

        <p class="eyebrow">
          <span></span> COFFEE, WITHOUT THE ORDINARY
        </p>

        <h1>
          The Art of the<br>
          <em>Ocean Brew.</em>
        </h1>

        <p class="hero-text">
          Discover exceptional instant coffee, carefully roasted beans,
          and effortless brewing bags—crafted to make every cup feel extraordinary.
        </p>

        <div class="hero-actions">
          <a class="btn btn-gold" href="#shop">
            Shop our coffee <span>↗</span>
          </a>

          <a class="text-link" href="#story">
            Discover our story <span>→</span>
          </a>
        </div>

        <div class="hero-note">
          <span class="note-line"></span>
          <span>Three collections. One extraordinary ritual.</span>
        </div>

      </div>

      <div class="hero-visual">

        <div class="hero-image"></div>

        <div class="hero-stamp">
          <span>PREMIUM COFFEE</span>
          <strong>CRAFTED<br>WITH CARE</strong>
          <span>THE BROWN OCEAN WAY</span>
        </div>

        <div class="hero-caption">
          <span>01 / THE ART OF THE BREW</span>
          <span>DISCOVER THE COLLECTION ↓</span>
        </div>

      </div>

    </section>

    <!-- Trust Strip -->
    <section class="trust-strip">

      <div>
        <span class="trust-icon">✳</span>
        <span>Rich, lasting aroma</span>
      </div>

      <div>
        <span class="trust-icon">◈</span>
        <span>Carefully selected beans</span>
      </div>

      <div>
        <span class="trust-icon">♨</span>
        <span>Made for your ritual</span>
      </div>

      <div>
        <span class="trust-icon">♡</span>
        <span>Little moments, elevated</span>
      </div>

    </section>

    <!-- Shop Section -->
    <section class="section shop-section" id="shop">

      <div class="section-heading reveal">

        <div>
          <p class="eyebrow">THE COLLECTION</p>

          <h2>
            Your coffee.<br>
            <em>Your kind of ritual.</em>
          </h2>
        </div>

        <p class="section-intro">
          From quick, beautiful mornings to slow weekend brews,
          find the coffee that feels like you.
        </p>

      </div>

      <div class="category-tabs" role="tablist" aria-label="Filter by coffee type">

        <button class="category-tab active" data-filter="all">
          All coffee <span>12</span>
        </button>

        <button class="category-tab" data-filter="instant">
          Instant coffee <span>04</span>
        </button>

        <button class="category-tab" data-filter="beans">
          Roasted beans <span>04</span>
        </button>

        <button class="category-tab" data-filter="bags">
          Brewing bags <span>04</span>
        </button>

      </div>

      <div class="product-grid" id="product-grid"></div>

      <div class="shop-bottom">
        <span>GOOD THINGS TAKE A LITTLE TIME.</span>

        <button class="underlined-btn" id="show-all">
          Explore all coffee <span>↗</span>
        </button>
      </div>

    </section>

    <!-- Story Section -->
    <section class="story-section" id="story">

      <div class="story-photo reveal">
        <div class="photo-label">
          ROOTED IN THE DETAILS <span>— 01</span>
        </div>
      </div>

      <div class="story-copy reveal">

        <p class="eyebrow">A NOTE FROM BROWN OCEAN</p>

        <h2>
          From the first<br>
          aroma to the<br>
          <em>last little sip.</em>
        </h2>

        <p>
          We believe coffee is more than a caffeine fix.
          It is the pause before the day begins, the conversation
          that runs late, the familiar comfort in an ordinary afternoon.
        </p>

        <p>
          That is why we care about the little things:
          the character of the beans, the balance in every blend,
          and the feeling your first sip leaves behind.
        </p>

        <a href="#ritual" class="text-link">
          Get to know our approach <span>→</span>
        </a>

        <div class="signature">
          Make room for good coffee
          <span>Brown Ocean Coffee</span>
        </div>

      </div>

    </section>

    <!-- Ritual Section -->
    <section class="ritual-section" id="ritual">

      <div class="ritual-top reveal">

        <p class="eyebrow">MAKE IT YOURS</p>

        <h2>
          Three ways to find<br>
          <em>your moment.</em>
        </h2>

        <p>
          Different days call for different cups.
          There is a Brown Ocean ritual for all of them.
        </p>

      </div>

      <div class="ritual-cards">

        <article class="ritual-card ritual-instant reveal">

          <div class="ritual-number">01</div>

          <div>
            <p class="eyebrow">FOR THE EVERYDAY</p>
            <h3>Instant coffee</h3>

            <p>
              Beautifully simple, full of character.
              Your favourite cup, made in a moment.
            </p>

            <a href="#shop" data-jump-filter="instant">
              Find your flavour ↗
            </a>
          </div>

        </article>

        <article class="ritual-card ritual-beans reveal">

          <div class="ritual-number">02</div>

          <div>
            <p class="eyebrow">FOR THE SLOW MORNINGS</p>
            <h3>Roasted beans</h3>

            <p>
              Freshly ground aroma and a little more time
              spent doing something well.
            </p>

            <a href="#shop" data-jump-filter="beans">
              Explore the roast ↗
            </a>
          </div>

        </article>

        <article class="ritual-card ritual-bags reveal">

          <div class="ritual-number">03</div>

          <div>
            <p class="eyebrow">FOR WHEREVER YOU ARE</p>
            <h3>Brewing bags</h3>

            <p>
              A considered brew, without the fuss.
              Take a better coffee break anywhere.
            </p>

            <a href="#shop" data-jump-filter="bags">
              Meet brew bags ↗
            </a>
          </div>

        </article>

      </div>

    </section>

    <!-- Quote Section -->
    <section class="quote-section">

      <div class="quote-mark">“</div>

      <blockquote>
        Make the everyday<br>
        <em>worth slowing down for.</em>
      </blockquote>

      <p>THE BROWN OCEAN WAY</p>

      <div class="quote-decoration"></div>

    </section>

    <!-- Newsletter Section -->
    <section class="newsletter">

      <div class="newsletter-symbol">◉</div>

      <div>

        <p class="eyebrow">A GOOD THING IN YOUR INBOX</p>

        <h2>
          A little coffee<br>
          <em>note from us.</em>
        </h2>

        <p>
          New blends, brew ideas and small reasons to take a pause.
        </p>

      </div>

      <form id="newsletter-form">

        <label for="email">Your email address</label>

        <div class="email-row">

          <input
            id="email"
            type="email"
            placeholder="you@example.com"
            required
          >

          <button type="submit" aria-label="Subscribe">
            Join us ↗
          </button>

        </div>

        <small id="newsletter-message">
          No noise. Just good coffee, occasionally.
        </small>

      </form>

    </section>

  </main>

  <!-- Footer -->
  <footer class="site-footer" id="footer">

    <div class="footer-main">

      <div class="footer-brand">

        <a class="brand brand-light" href="#top" aria-label="Brown Ocean Coffee home">

          <img
            class="brand-logo footer-logo"
            src="./assets/images/brown-ocean-coffee-circular-badge.png"
            alt="Brown Ocean Coffee logo"
          >

        </a>

        <p>
          For the moments that deserve<br>
          a really good cup.
        </p>

        <div class="social-links">
          <a href="#footer" aria-label="Instagram">ig</a>
          <a href="#footer" aria-label="Facebook">f</a>
          <a href="#footer" aria-label="YouTube">▶</a>
        </div>

      </div>

      <div class="footer-col">

        <h4>EXPLORE</h4>

        <a href="#shop">Shop all coffee</a>
        <a href="#shop" data-jump-filter="instant">Instant coffee</a>
        <a href="#shop" data-jump-filter="beans">Roasted beans</a>
        <a href="#shop" data-jump-filter="bags">Brewing bags</a>

      </div>

      <div class="footer-col">

        <h4>THE DETAILS</h4>

        <a href="#story">Our story</a>
        <a href="#ritual">Our coffee ritual</a>
        <a href="mailto:hello@brownoceancoffee.com">Get in touch</a>
        <a href="#footer">Shipping & returns</a>

      </div>

      <div class="footer-contact">

        <p class="eyebrow">HAVE A QUESTION?</p>

        <a class="footer-email" href="mailto:hello@brownoceancoffee.com">
          Let's talk coffee ↗
        </a>

        <p>hello@brownoceancoffee.com</p>

      </div>

    </div>

    <div class="footer-bottom">

      <span>
        © <span id="year"></span> Brown Ocean Coffee.
        Made for good moments.
      </span>

      <span>BREW SLOW. LIVE WELL.</span>

      <a href="#top">Back to top ↑</a>

    </div>

  </footer>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <!-- Cart Overlay -->
  <div class="cart-overlay" id="cart-overlay">

    <aside class="cart-drawer" aria-label="Shopping bag">

      <div class="drawer-head">

        <div>
          <p class="eyebrow">YOUR LITTLE COLLECTION</p>
          <h3>Your bag <span id="drawer-count">(0)</span></h3>
        </div>

        <button class="drawer-close" aria-label="Close cart">×</button>

      </div>

      <div class="cart-items" id="cart-items">

        <div class="empty-cart">
          Your bag is taking a quiet moment.<br>
          <a href="#shop" class="drawer-close-link">
            Find your coffee →
          </a>
        </div>

      </div>

      <div class="cart-summary">

        <div>
          <span>Subtotal</span>
          <strong id="cart-subtotal">₹0</strong>
        </div>

        <small>Shipping calculated at checkout.</small>

        <button class="btn btn-gold checkout-btn" id="checkout-btn">
          Continue to checkout ↗
        </button>

        <p class="demo-note">
          Demo storefront — checkout is not connected yet.
        </p>

      </div>

    </aside>

  </div>

  <!-- Search Overlay -->
  <div class="search-overlay" id="search-overlay">

    <div class="search-box">

      <button class="search-close" aria-label="Close search">×</button>

      <p class="eyebrow">FIND YOUR FAVOURITE</p>

      <label for="search-input">
        What are you in the mood for?
      </label>

      <input
        id="search-input"
        placeholder="Try hazelnut, roast, brew bags…"
      >

      <div id="search-results"></div>

    </div>

  </div>

  <!-- Product Modal -->
  <div class="product-modal" id="product-modal" aria-hidden="true">

    <div class="product-modal-backdrop" data-close-product></div>

    <section
      class="product-modal-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-product-name"
    >

      <button
        class="product-modal-close"
        data-close-product
        aria-label="Close product details"
      >
        ×
      </button>

      <div class="modal-product-image">
        <img id="modal-product-image" src="" alt="">
      </div>

      <div class="modal-product-copy">

        <p class="eyebrow" id="modal-product-category"></p>

        <h2 id="modal-product-name"></h2>

        <p class="modal-rating">
          ★★★★★ <span>Thoughtfully selected coffee</span>
        </p>

        <p id="modal-product-description"></p>

        <div class="modal-price" id="modal-product-price"></div>

        <label for="modal-size">Choose your size</label>
        <select id="modal-size"></select>

        <label for="modal-qty">Quantity</label>

        <div class="modal-quantity">

          <button type="button" id="modal-qty-minus" aria-label="Decrease quantity">
            −
          </button>

          <input id="modal-qty" type="number" min="1" value="1">

          <button type="button" id="modal-qty-plus" aria-label="Increase quantity">
            +
          </button>

        </div>

        <button class="btn btn-gold modal-add" id="modal-add-to-cart">
          Add to bag ↗
        </button>

        <p class="modal-footnote">
          Secure checkout will be available once payments are connected.
        </p>

      </div>

    </section>

  </div>

  <!-- JavaScript -->
  <script src="app.js"></script>

</body>
</html>
